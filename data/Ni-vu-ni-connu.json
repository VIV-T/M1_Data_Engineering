      "type": "text",
      "content": "Monsieur Bluette, combien de d�tenus avez-vous en ce moment\n           dans votre prison ?"
    },
    {
      "type": "tag",
      "name": "b",
      "content": "<b>                          MONSIEUR BLUETTE\n</b>"
    },
