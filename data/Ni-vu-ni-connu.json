    {
      "type": "tag",
      "name": "b",
      "content": "<b>                          MONSIEUR DUBENO�T\n</b>"
    },
    {
      "type": "text",
      "content": "�a, c'est du Blaireau tout pur !\n                         \n          Parju tourne la t�te de c�t� pour dire :"
